{
  "id": "cat_chunks_funcionals",
  "title": "Frases fetes — sobreviure en una conversa",
  "level": "A2",
  "note": "**FR** : des phrases toutes faites à ressortir sans réfléchir. Ce sont tes bouées de sauvetage quand tu parles. Traduis en catalan.\n**EN** : ready-made survival phrases you fire off without thinking. Translate into Catalan.\n\nAstuce : mémorise-les comme des blocs, pas mot à mot.",
  "drills": [
    { "prompt": "Comment on dit… ? →", "answer": "Com es diu...?", "hint": "com es diu" },
    { "prompt": "Qu'est-ce que ça veut dire ? →", "answer": "Què vol dir?", "hint": "vol dir" },
    { "prompt": "Peux-tu répéter, s'il te plaît ? →", "answer": "Pots repetir, si us plau?", "hint": "pots repetir" },
    { "prompt": "Je ne comprends pas. →", "answer": "No ho entenc.", "hint": "ho entenc" },
    { "prompt": "Peux-tu m'aider ? →", "answer": "Em pots ajudar?", "hint": "em pots" },
    { "prompt": "Je veux dire que… →", "answer": "Vull dir que...", "hint": "vull dir" },
    { "prompt": "Peux-tu parler plus lentement ? →", "answer": "Pots parlar més a poc a poc?", "hint": "a poc a poc" },
    { "prompt": "Comment ça va ? (familier) →", "answer": "Com va?", "hint": "com va" },
    { "prompt": "Ce n'est pas grave. / Pas de souci. →", "answer": "No passa res.", "hint": "no passa res" },
    { "prompt": "De rien. →", "answer": "De res.", "hint": "de res" },
    { "prompt": "Combien ça coûte ? →", "answer": "Quant costa?", "hint": "quant costa" },
    { "prompt": "Où est… ? →", "answer": "On és...?", "hint": "on és" },
    { "prompt": "À quelle heure… ? →", "answer": "A quina hora...?", "hint": "quina hora" },
    { "prompt": "Pardon / Excuse-moi. →", "answer": "Perdona.", "hint": "perdona / disculpa" }
  ]
}
